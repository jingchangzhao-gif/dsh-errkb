{
  "name": "dsh-errkb",
  "version": "0.0.0",
  "description": "DSH connector for the Error Knowledge Base: recycle errors - diagnose once, inject the known fix next time.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jingchangzhao-gif/error-knowledge-base.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --coverage",
    "test:release": "pwsh -NoProfile -File packaging/windows/release-test.ps1",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^2.1.9",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.7.0"
}
