# Generated by pnpm: it rewrites the file on every resolution, and prettier
# would rewrite it back on every check.
pnpm-lock.yaml

# Generated output. Prettier does not read .gitignore, so without these two
# entries a local `pnpm run build` or a coverage run turns `format:check` red.
lib/
coverage/

# Authored before this repository had a formatter, and outside the scope of the
# tasks that introduced one. Reformatting them is a separate, reviewable change;
# the design document in particular is the source of truth and stays as its
# author wrote it.
README.md
README.zh-CN.md
README.toolbox.md
README.toolbox.zh-CN.md
docs/

# Written byte-for-byte by src/store.ts, and tests/seeds.test.ts fails if a
# formatter changes a character. errors/ is the runtime knowledge base.
seeds/
errors/

# Local working notes. They are not part of the published package.
dsh-errkb/

# Historical EKB task cards. Their original formatting is retained as archived
# implementation evidence; the active workflow lives under docs/.
.md workflow/

# Upgrade fixtures (EKB-053) are historical artifacts: the schema dump, the old
# configuration file and the Markdown documents must stay byte-for-byte as the
# old releases wrote them, so a formatter must not touch them.
db/migrations/testdata/
