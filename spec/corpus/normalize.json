{
  "corpus": "normalize",
  "sources": [
    "tests/signature.test.ts",
    "tests/gen-corpus.ts (curated overlong and composite cases)"
  ],
  "coverage": [
    "ANSI CSI and OSC stripping",
    "whitespace and carriage-return collapse",
    "UUID, 32+ hex, timestamp, clock, duration, pid, port, host:port, line/column and temp-dir placeholders",
    "absolute path collapsing, POSIX and Windows",
    "lowercasing and edge punctuation",
    "overlong input"
  ],
  "not_covered": [
    "the 200 000-character unit-test input is bounded to 1200 characters",
    "template-literal and helper-built arguments stay in tests/signature.test.ts"
  ],
  "cases": [
    {
      "case_id": "normalize-001",
      "source_test": "tests/signature.test.ts#normalize",
      "input": "\u001b[31mError:\u001b[0m boom",
      "expected": "error: boom"
    },
    {
      "case_id": "normalize-002",
      "source_test": "tests/signature.test.ts#normalize",
      "input": "\u001b]8;;https://example.com\u0007link\u001b]8;;\u001b\\ failed",
      "expected": "link failed"
    },
    {
      "case_id": "normalize-003",
      "source_test": "tests/signature.test.ts#normalize",
      "input": "a\r\nb\t\t c   d",
      "expected": "a b c d"
    },
    {
      "case_id": "normalize-004",
      "source_test": "tests/signature.test.ts#normalize",
      "input": "at 2026-09-14T09:12:33.120Z failed",
      "expected": "at <ts> failed"
    },
    {
      "case_id": "normalize-005",
      "source_test": "tests/signature.test.ts#normalize",
      "input": "on 2026-09-14 09:12 failed",
      "expected": "on <ts> failed"
    },
    {
      "case_id": "normalize-006",
      "source_test": "tests/signature.test.ts#normalize",
      "input": "on 2026-09-14 failed",
      "expected": "on <ts> failed"
    },
    {
      "case_id": "normalize-007",
      "source_test": "tests/signature.test.ts#normalize",
      "input": "at 9:12:33 failed",
      "expected": "at <ts> failed"
    },
    {
      "case_id": "normalize-008",
      "source_test": "tests/signature.test.ts#normalize",
      "input": "at 2026-09-14T09:12:33+08:00 failed",
      "expected": "at <ts> failed"
    },
    {
      "case_id": "normalize-009",
      "source_test": "tests/signature.test.ts#normalize",
      "input": "timed out after 1234ms",
      "expected": "timed out after <ts>"
    },
    {
      "case_id": "normalize-010",
      "source_test": "tests/signature.test.ts#normalize",
      "input": "timed out after 1.5s",
      "expected": "timed out after <ts>"
    },
    {
      "case_id": "normalize-011",
      "source_test": "tests/signature.test.ts#normalize",
      "input": "timed out after 30 ms",
      "expected": "timed out after <ts>"
    },
    {
      "case_id": "normalize-012",
      "source_test": "tests/signature.test.ts#normalize",
      "input": "耗时 123ms 超时",
      "expected": "耗时 <ts> 超时"
    },
    {
      "case_id": "normalize-013",
      "source_test": "tests/signature.test.ts#normalize",
      "input": "耗时 123 毫秒",
      "expected": "耗时 <ts>"
    },
    {
      "case_id": "normalize-014",
      "source_test": "tests/signature.test.ts#normalize",
